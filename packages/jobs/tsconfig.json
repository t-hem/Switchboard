{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "nodenext",
    "moduleResolution": "nodenext", "strict": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "sourceMap": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "outDir": "dist", "rootDir": "src", "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
