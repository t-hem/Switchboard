{
  "name": "@switchboard/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "switchboard-host": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "accept:sessions": "node acceptance/sessions.mjs",
    "accept:orphans": "node acceptance/orphans.mjs",
    "accept:real": "node acceptance/real-agent.mjs",
    "accept:tmux-spike": "node acceptance/tmux-spike.mjs",
    "accept:restart": "node acceptance/restart.mjs",
    "recover": "node dist/recovery-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "nanoid": "^5.1.6",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/ws": "^8.18.1",
    "@xterm/headless": "^5.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  }
}
